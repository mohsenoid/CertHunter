<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        QUERY_ALL_PACKAGES — required for CertHunter's core function.

        CertHunter is a developer utility that reads signing-certificate
        fingerprints and X.509 details from ANY app installed on the device.
        Enumerating the full installed-app list is the app's only purpose;
        the user selects an app from that list to inspect its certificate.

        A <queries> element cannot substitute: it only makes a predefined set
        of packages visible, making full enumeration impossible.

        Google Play permission disclosure: declared in the Play Store console
        with the justification that this is a developer-tool app whose sole
        function is certificate inspection across all installed packages.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CertHunter">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CertHunter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>